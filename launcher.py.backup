#!/usr/bin/env python
import subprocess
import sys
import os
import time
import threading
import tkinter as tk
from tkinter import messagebox
import webbrowser

# Функция для запуска бэкенда в фоне
def start_backend():
    # Определяем команду в зависимости от ОС
    if sys.platform == "win32":
        cmd = ["pythonw", "main.py"]  # без окна
    else:
        cmd = ["nohup", "python", "main.py", ">", "backend.log", "2>&1", "&"]
    # Запускаем процесс
    if sys.platform == "win32":
        subprocess.Popen(cmd, creationflags=subprocess.CREATE_NO_WINDOW)
    else:
        subprocess.Popen(" ".join(cmd), shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Даём время на запуск
    time.sleep(2)
    print("✅ Бэкенд запущен в фоне.")

# Функция для генерации отчёта (вызывается из GUI)
def generate_report(scan_id=None):
    if scan_id is None:
        # Получаем последний ID сканирования из БД
        try:
            import sqlite3
            conn = sqlite3.connect("scanner.db")
            c = conn.cursor()
            c.execute("SELECT id FROM scan_tasks ORDER BY id DESC LIMIT 1")
            row = c.fetchone()
            conn.close()
            if row:
                scan_id = row[0]
            else:
                messagebox.showinfo("Информация", "Нет завершённых сканирований.")
                return
        except Exception as e:
            messagebox.showerror("Ошибка", f"Не удалось получить ID сканирования: {e}")
            return
    # Запускаем генерацию отчёта в фоне
    subprocess.Popen(["python", "run_report.py", str(scan_id)])
    messagebox.showinfo("Успех", f"Отчёт для сканирования #{scan_id} создаётся в фоне.")

# Запускаем бэкенд (если он ещё не запущен) – проверяем порт 8000
def is_backend_running():
    import socket
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    result = sock.connect_ex(('127.0.0.1', 8000))
    sock.close()
    return result == 0

if not is_backend_running():
    start_backend()

# Теперь запускаем основное GUI приложение (ваш main_window.py или desktop_app.py)
# Предполагаем, что ваш основной файл называется desktop_app.py или main_window.py
# Проверяем наличие и запускаем
if os.path.exists("desktop_app.py"):
    gui_file = "desktop_app.py"
elif os.path.exists("main_window.py"):
    gui_file = "main_window.py"
else:
    print("❌ Не найден файл GUI. Убедитесь, что есть desktop_app.py или main_window.py")
    sys.exit(1)

# Импортируем ваше приложение и запускаем
import importlib
gui_module = importlib.import_module(gui_file.replace('.py', ''))
# Предполагаем, что в вашем файле есть функция main() или класс, который запускает окно.
# Если у вас main_window.py содержит класс MainWindow и запуск через if __name__ == '__main__',
# то можно просто выполнить этот файл через subprocess, чтобы не смешивать контексты.
# Для простоты запустим через subprocess, чтобы не было конфликтов импорта.
subprocess.Popen(["python", gui_file])
print(f"✅ Запущен GUI: {gui_file}")

# Ждём завершения (по желанию можно не ждать, а закрыть этот скрипт)
try:
    while True:
        time.sleep(1)
except KeyboardInterrupt:
    print("Завершение...")
